{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miino-systems.github.io/pdf-workbench/schemas/preflight.schema.json",
  "title": "PDF Workbench: preflight.json",
  "description": "PDF を出力前にチェックするルール（ページサイズ・余白・ページ数・スタンプ衝突）。",
  "type": "object",
  "required": [
    "version",
    "id"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "このファイルが従う JSON Schema の URL。エディタの補完用で、アプリは読み込み時に無視する。"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "preflight.json のフォーマットバージョン（現在は 1）。"
    },
    "id": {
      "type": "string",
      "description": "このルールの識別子。preflight レポートの `configId` に記録される。"
    },
    "name": {
      "type": "string",
      "description": "表示名。"
    },
    "page": {
      "type": "object",
      "description": "ページサイズ・向きのチェック。省略したキーはチェックしない。",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "description": "期待するページサイズの名前（例: `A4`, `Letter`）。core/units.ts の PAPER_SIZES_PT に定義されたキー。"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ],
          "description": "期待するページの向き。"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "ページサイズ比較の許容誤差（pt、既定 2）。（用紙サイズの判定にのみ使う。余白の許容誤差は margins.tolerance）"
        }
      }
    },
    "margins": {
      "$ref": "#/$defs/PreflightMargins"
    },
    "pages": {
      "type": "object",
      "description": "ページ数のチェック。",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "description": "最小ページ数（未満だと警告）。"
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "description": "最大ページ数（超過すると警告）。"
        }
      }
    },
    "marginOverrides": {
      "type": "array",
      "description": "特定ページだけ margins の一部を上書きする。配列の後の要素ほど優先され、各要素は指定した辺だけを上書きする（省略した辺は base の margins のまま）。単位は上書きされる側の margins.unit に従う。",
      "items": {
        "$ref": "#/$defs/PreflightMarginOverride"
      }
    },
    "textRules": {
      "type": "array",
      "description": "指定ページに必ずある（require）／あってはならない（forbid）テキストの正規表現ルール。常に実行される（checks のスイッチはない）。",
      "items": {
        "$ref": "#/$defs/PreflightTextRule"
      }
    },
    "checks": {
      "type": "object",
      "description": "各チェックの有効/無効。",
      "additionalProperties": false,
      "properties": {
        "marginText": {
          "type": "boolean",
          "description": "PDF のテキストオブジェクト座標に基づく余白チェック（getTextContent）。"
        },
        "marginRaster": {
          "type": "boolean",
          "description": "ラスタライズした画像に基づく余白チェック（テキスト以外の描画も検出できる）。"
        },
        "stampCollision": {
          "type": "boolean",
          "description": "スタンプが既存の描画（テキスト・画像・罫線など）と重ならないかのラスタベースのチェック。新規 Workspace では既定で true。"
        },
        "stampDuplicate": {
          "type": "boolean",
          "description": "有効なスタンプのテキストや画像と同じものが原稿にすでに入っていないか（著者が入れたライセンス表記やロゴとの二重化）。新規 Workspace では既定で true。"
        }
      }
    }
  },
  "$defs": {
    "PreflightTextRule": {
      "type": "object",
      "description": "テキストルール（require と forbid の少なくとも一方を書く。どちらもないルールは何もしない）。テキストは各ページの文字列を、改行・連続した空白を空白 1 つにしてつないだもの。require は選んだページのどこにも一致しなければ TEXT_REQUIRED:<id>（最初のページに報告）、forbid は一致した箇所ごとに TEXT_FORBIDDEN:<id>。",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "ルール名。報告されるコードの一部になる（例: orcid → TEXT_REQUIRED:orcid）。"
        },
        "pages": {
          "$ref": "stamps.schema.json#/$defs/PageSelector",
          "description": "対象ページ（省略時は全ページ）。"
        },
        "require": {
          "type": "string",
          "description": "対象ページのどこかに一致しなければならない正規表現（JavaScript、u フラグ付き）。"
        },
        "forbid": {
          "type": "string",
          "description": "対象ページのどこにも一致してはならない正規表現（JavaScript、u フラグ付き）。"
        },
        "flags": {
          "type": "string",
          "pattern": "^[imsdv]*$",
          "description": "追加の正規表現フラグ（例: i で大文字小文字を無視）。"
        },
        "message": {
          "type": "string",
          "description": "注釈付きコピーや結果一覧に出す説明（省略時は既定の文言）。"
        },
        "severity": {
          "enum": ["warning", "error"],
          "description": "既定は warning。"
        }
      }
    },
    "PreflightMargins": {
      "type": "object",
      "description": "余白（ページの端から本文までの距離）。",
      "required": [
        "top",
        "bottom",
        "left",
        "right",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0,
          "description": "上余白。"
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "description": "下余白。"
        },
        "left": {
          "type": "number",
          "minimum": 0,
          "description": "左余白。"
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "description": "右余白。"
        },
        "unit": {
          "type": "string",
          "enum": [
            "mm",
            "pt",
            "in"
          ],
          "description": "top/bottom/left/right の単位。"
        },
        "tolerance": {
          "description": "余白の線からこの距離（pt、unit によらず pt）までのはみ出しは違反にしない。数値なら上下左右共通、オブジェクトなら辺ごと（省略した辺は既定 2）。page.tolerance（用紙サイズの許容誤差）とは別。",
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "top": {
                  "type": "number",
                  "minimum": 0
                },
                "bottom": {
                  "type": "number",
                  "minimum": 0
                },
                "left": {
                  "type": "number",
                  "minimum": 0
                },
                "right": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        }
      }
    },
    "PreflightMarginOverride": {
      "type": "object",
      "description": "特定のページ集合に対する margins の部分的な上書き（指定した辺のみ）。",
      "required": [
        "pages",
        "margins"
      ],
      "additionalProperties": false,
      "properties": {
        "pages": {
          "$ref": "stamps.schema.json#/$defs/PageSelector"
        },
        "margins": {
          "type": "object",
          "description": "上書きする辺だけを指定する（単位は base の margins.unit に従う）。",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0
            },
            "bottom": {
              "type": "number",
              "minimum": 0
            },
            "left": {
              "type": "number",
              "minimum": 0
            },
            "right": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
